[Unit]
Description=Claude SEO and Blog Web Console GUI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/claude-web-gui
ExecStart=/root/claude-web-gui/run.sh
Restart=always
RestartSec=3
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=HOME=/root
Environment=LANG=en_US.UTF-8
Environment=AUTH_PASSWORD=claude2026

[Install]
WantedBy=multi-user.target
